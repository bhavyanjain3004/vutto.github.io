datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BUYER
  ADMIN
}

enum AuctionStatus {
  LIVE
  UPCOMING
  ENDED
  CANCELLED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  role         Role       @default(BUYER)
  city         String     @default("Delhi NCR")
  phone        String?
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  bids           Bid[]
  wonAuctions    Auction[]      @relation("AuctionWinner")
  leadingAuctions Auction[]     @relation("AuctionCurrentBidder")
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Bike {
  id                String    @id @default(uuid())
  brand             String
  model             String
  variant           String
  year              Int
  kilometers        Int
  fuel              String    @default("Petrol")
  engineCc          Int       @map("engine_cc")
  city              String
  image             String
  certified         Boolean   @default(true)
  inspectionScore   Float     @default(9.0) @map("inspection_score")
  checkpointsPassed Int       @default(200) @map("checkpoints_passed")
  owner             String    @default("1st Owner")
  specs             Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  auctions          Auction[]

  @@index([brand])
  @@index([city])
  @@map("bikes")
}

model Auction {
  id                         String        @id @default(uuid())
  bikeId                     String        @map("bike_id")
  title                      String
  status                     AuctionStatus @default(UPCOMING)
  startsAt                   DateTime      @map("starts_at") @db.Timestamptz
  endsAt                     DateTime      @map("ends_at") @db.Timestamptz
  startingPrice              Int           @map("starting_price")
  currentPrice               Int           @map("current_price")
  minIncrement               Int           @default(500) @map("min_increment")
  totalBids                  Int           @default(0) @map("total_bids")
  winnerId                   String?       @map("winner_id")
  currentBidderId            String?       @map("current_bidder_id")
  antiSnipeWindowSeconds     Int           @default(120) @map("anti_snipe_window_seconds")
  antiSnipeExtensionSeconds  Int           @default(120) @map("anti_snipe_extension_seconds")
  /// Sequence number incremented atomically on every accepted bid and broadcast via socket events
  version                    Int           @default(0)
  createdAt                  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  bike                       Bike          @relation(fields: [bikeId], references: [id], onDelete: Restrict)
  winner                     User?         @relation("AuctionWinner", fields: [winnerId], references: [id])
  currentBidder              User?         @relation("AuctionCurrentBidder", fields: [currentBidderId], references: [id])
  bids                       Bid[]

  @@index([status, endsAt])
  @@index([status, startsAt])
  @@map("auctions")
}

model Bid {
  id             String   @id @default(uuid())
  auctionId      String   @map("auction_id")
  userId         String   @map("user_id")
  amount         Int
  idempotencyKey String?  @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  auction        Auction  @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@unique([auctionId, amount])
  @@index([auctionId, amount(sort: Desc)])
  @@index([auctionId, createdAt])
  @@map("bids")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
