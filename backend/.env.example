PORT=3000
NODE_ENV=development

# Database Configuration
POSTGRES_USER=vutto
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=vutto_db
DATABASE_URL=postgresql://vutto:your_secure_postgres_password@localhost:5432/vutto_db?schema=public
DATABASE_URL_DOCKER=postgresql://vutto:your_secure_postgres_password@postgres:5432/vutto_db?schema=public

# Authentication Secrets (Generate secure random strings in production)
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRATION=900s
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_at_least_32_characters_long
JWT_REFRESH_EXPIRATION=7d

# Security & CORS
THROTTLE_TTL=60
THROTTLE_LIMIT=120
FRONTEND_ORIGIN=http://localhost:5173
